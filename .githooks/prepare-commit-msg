#!/bin/sh
#
# Git prepare-commit-msg hook: link commits to dev-docs tasks.
#
# Injects `Task:` / `Docs:` trailers when the repo has exactly one active task,
# so the commit -> task link does not depend on the author remembering it.
#
# The trailers are what `ctl-project-governance.mjs commits --task T-###` reads
# back to reconstruct a task's progress after a context reset.
#
# Skip once: SKIP_TASK_TRAILER=1 git commit -m "..."
#
# Install: node .githooks/install.mjs
# Uninstall: node .githooks/install.mjs --uninstall
#

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Messages generated by git itself are left untouched.
case "$COMMIT_SOURCE" in
  merge|squash) exit 0 ;;
esac

if [ "$SKIP_TASK_TRAILER" = "1" ]; then
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  exit 0
fi

if [ ! -f .ai/scripts/ctl-project-governance.mjs ]; then
  exit 0
fi

# Already linked (explicit trailer, or `git commit --amend`).
# Parse real trailers only, not arbitrary "Task:" lines in the body.
if git interpret-trailers --parse <"$COMMIT_MSG_FILE" | grep -qE '^Task:[[:space:]]*[^[:space:]]'; then
  exit 0
fi

# Exit codes: 0 resolved, 2 ambiguous, 3 none, 4 not found.
# Anything other than 0 means there is nothing safe to inject.
TRAILERS=$(node .ai/scripts/ctl-project-governance.mjs current-task --format trailers 2>/dev/null)
if [ $? -ne 0 ] || [ -z "$TRAILERS" ]; then
  exit 0
fi

echo "$TRAILERS" | while IFS= read -r trailer; do
  [ -n "$trailer" ] || continue
  git interpret-trailers --if-exists doNothing --in-place --trailer "$trailer" "$COMMIT_MSG_FILE"
done

echo "[hook] Linked commit to $(echo "$TRAILERS" | head -1)"
exit 0
