#!/bin/sh
#
# Git prepare-commit-msg hook: link commits to dev-docs tasks.
#
# Injects `Task:` only when the current branch contains one valid task ID.
# It never infers commit ownership from the repository's active-task count.
#
# Skip once: SKIP_TASK_TRAILER=1 git commit -m "..."
#
# Install: node .githooks/install.mjs
# Uninstall: node .githooks/install.mjs --uninstall
#

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Messages generated by git itself are left untouched.
case "$COMMIT_SOURCE" in
  merge|squash) exit 0 ;;
esac

if [ "$SKIP_TASK_TRAILER" = "1" ]; then
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  exit 0
fi

if [ ! -f .ai/scripts/ctl-project-governance.mjs ]; then
  exit 0
fi

# Already linked (explicit trailer, or `git commit --amend`).
# Parse real trailers only, not arbitrary "Task:" lines in the body.
if git interpret-trailers --parse <"$COMMIT_MSG_FILE" | grep -qE '^Task:[[:space:]]*[^[:space:]]'; then
  exit 0
fi

# Branch identity is the only safe automatic signal available to a Git hook.
BRANCH=$(git branch --show-current 2>/dev/null)
TASK_IDS=$(printf '%s\n' "$BRANCH" | grep -oE 'T-[0-9]{3}' | sort -u)
TASK_COUNT=$(printf '%s\n' "$TASK_IDS" | grep -c .)

if [ "$TASK_COUNT" -ne 1 ]; then
  exit 0
fi

TASK_ID=$TASK_IDS
if ! node .ai/scripts/ctl-project-governance.mjs current-task --task "$TASK_ID" --format id >/dev/null 2>&1; then
  exit 0
fi

git interpret-trailers --if-exists doNothing --in-place --trailer "Task: $TASK_ID" "$COMMIT_MSG_FILE"

echo "[hook] Linked commit to Task: $TASK_ID"
exit 0
